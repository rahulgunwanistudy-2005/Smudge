{
  "name": "smudge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "AI Assisted/app"
  ],
  "scripts": {
    "dev": "npm run dev -w smudge-app -- --host 127.0.0.1",
    "build": "npm run build:detector && npm run build -w smudge-app && node 'AI Assisted/scripts/security-headers.mjs' && node 'AI Assisted/scripts/compress-assets.mjs'",
    "preview": "node 'AI Assisted/scripts/serve.mjs'",
    "check": "npm run check -w smudge-app",
    "test": "vitest run",
    "test:e2e": "python3 'AI Assisted/tests/e2e.py'",
    "assets": "node 'AI Assisted/scripts/prepare-assets.mjs'",
    "build:wasm": "python3 'AI Assisted/scripts/build-engine.py' --wasm",
    "build:native": "python3 'AI Assisted/scripts/build-engine.py'",
    "eval": "python3 'AI Assisted/lab/eval/run.py'",
    "verify": "npm run check && npm test && npm run build",
    "build:detector": "esbuild 'AI Assisted/scripts/detect-worker.ts' --bundle --format=iife --platform=browser --outfile='AI Assisted/app/static/detect-worker.js' --minify",
    "eval:independent": "python3 'AI Assisted/lab/eval/independent.py'",
    "budget": "node 'AI Assisted/scripts/performance.mjs'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
